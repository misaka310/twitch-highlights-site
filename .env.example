# Twitch API credentials used by scripts/update_vods.py
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional instance overrides. Defaults come from config/site.json.
TWITCH_CHANNEL=
TWITCH_CHANNEL_ID=
SITE_NAME=
SITE_DESCRIPTION=
SITE_BASE_URL=
SITE_LANGUAGE=ja
GOATCOUNTER_CODE=

# Optional headline generation provider
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Optional local transcription tuning
TRANSCRIPT_MODEL=large-v3-turbo
TRANSCRIPT_BEAM_SIZE=3
TRANSCRIPT_CONDITION_ON_PREVIOUS_TEXT=false
TRANSCRIPT_VAD_FILTER=true
TRANSCRIPT_VAD_MIN_SILENCE_DURATION_MS=2000
TRANSCRIPT_MAX_SEGMENTS=9
TRANSCRIPT_MAX_DURATION_SEC=150
SEGMENT_SCREENSHOT_GENERATION_ENABLED=true

# Oracle SSH transport. Real host, user, key, and script paths stay outside the repository.
YOUTUBE_ORACLE_HOST=
YOUTUBE_ORACLE_USER=
YOUTUBE_ORACLE_KEY_PATH=
YOUTUBE_ORACLE_SCRIPT_PATH=
YOUTUBE_ORACLE_REMOTE_YTDLP_PATH=$HOME/yt-dlp
YOUTUBE_ORACLE_REMOTE_DENO_PATH=$HOME/.local/bin/deno
YOUTUBE_ORACLE_REMOTE_COOKIES_PATH=$HOME/youtube-cookies.txt
YOUTUBE_ORACLE_REMOTE_TSV_TEMPLATE=$HOME/ytprobe/{video_id}-comment-times.tsv

# Oracle -> GitHub Actions temporary material handoff. Values stay outside the repository.
YOUTUBE_ORACLE_BUNDLE_UPLOAD_URL=
YOUTUBE_ORACLE_GITHUB_TOKEN=
YOUTUBE_ORACLE_GITHUB_REPOSITORY=
DISCORD_WEBHOOK_URL=
YOUTUBE_ORACLE_STATE_PATH=/var/lib/youtube-highlight/state.json
