# Twitch API credentials used by scripts/update_vods.py
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional instance overrides. Defaults come from config/site.json.
TWITCH_CHANNEL=
TWITCH_CHANNEL_ID=
SITE_NAME=
SITE_DESCRIPTION=
SITE_BASE_URL=
SITE_LANGUAGE=ja
GOATCOUNTER_CODE=

# Optional headline generation provider
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Optional local transcription tuning
TRANSCRIPT_MODEL=large-v3-turbo
TRANSCRIPT_BEAM_SIZE=3
TRANSCRIPT_CONDITION_ON_PREVIOUS_TEXT=false
TRANSCRIPT_VAD_FILTER=true
TRANSCRIPT_VAD_MIN_SILENCE_DURATION_MS=2000
TRANSCRIPT_MAX_SEGMENTS=9
TRANSCRIPT_MAX_DURATION_SEC=150
SEGMENT_SCREENSHOT_GENERATION_ENABLED=true
