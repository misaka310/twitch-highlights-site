{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".unit-test-dist",
    "noEmit": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "tests/unit/**/*.ts"],
  "exclude": ["src/**/*.tsx"]
}
