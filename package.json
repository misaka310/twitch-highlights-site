{
  "name": "twitch-highlights-site",
  "version": "2.0.0",
  "description": "Static Twitch highlights site",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "start": "npm run dev --prefix frontend",
    "setup": "npm ci && npm ci --prefix frontend",
    "build": "npm run build:public",
    "build:public": "sh scripts/build_public.sh",
    "typecheck": "npm run typecheck:frontend",
    "typecheck:frontend": "npm run typecheck --prefix frontend",
    "lint": "npm run lint:frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "test": "npm run verify",
    "test:frontend:unit": "npm run test:unit --prefix frontend",
    "test:frontend:e2e": "npm run test:e2e --prefix frontend",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:public": "playwright test --config=playwright.public.config.js",
    "test:live:twitch": "playwright test --config=playwright.twitch.config.js",
    "test:live:production": "playwright test --config=playwright.live.config.js",
    "check:public": "python scripts/check_public_build.py && python scripts/check_public_reproducibility.py",
    "check:live": "python scripts/verify_deployed_data.py",
    "check:repo-hygiene": "python scripts/check_repository_hygiene.py",
    "verify": "npm run typecheck:frontend && npm run lint:frontend && npm run test:frontend:unit && npm run test:python && npm run test:frontend:e2e && npm run build:public && npm run check:public && npm run test:public && npm run check:repo-hygiene",
    "verify:live": "npm run test:live:twitch && npm run test:live:production && npm run check:live",
    "test:e2e": "npm run test:frontend:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
